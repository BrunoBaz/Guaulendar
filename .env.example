# Copia este archivo como .env y completa los valores localmente.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# En local déjalo sin definir (equivale a True). En producción: False.
DJANGO_DEBUG=False

# Lista separada por comas. En Render no hace falta: se añade RENDER_EXTERNAL_HOSTNAME solo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF, con esquema (https://...). Opcional en Render.
DJANGO_CSRF_TRUSTED_ORIGINS=

# En local se usa SQLite aunque DATABASE_URL esté definido.
# Para conectarte intencionadamente a una base remota desde local, define DJANGO_USE_DATABASE_URL=True.
# Render activa automáticamente DATABASE_URL. Usa su URL pooled para la aplicación.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Correo saliente: recuperación de contraseña.
# En producción (Vercel) se envía por la API HTTP de Brevo, porque el runtime de
# Python de Vercel no puede abrir un socket SMTP. La clave está en Brevo ->
# SMTP & API -> API Keys, y el remitente tiene que estar verificado en
# Senders & Domains.
BREVO_API_KEY=

# Alternativa por SMTP, para servidores donde sí se pueda abrir el puerto (un VPS
# o un servidor de correo propio). Sin EMAIL_HOST el correo se escribe en la
# consola del servidor, que es lo que ocurre en local.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Remitente: en Brevo, una dirección verificada; con SMTP, del dominio verificado.
DEFAULT_FROM_EMAIL=Guaulendar <no-reply@tudominio.com>

# VeriFactu (facturación electrónica) usando la API REST de Irene Solutions.
# El usuario y la contraseña de cada negocio se introducen en el admin y se
# guardan cifrados con DJANGO_SECRET_KEY: no van en variables de entorno, así que
# SECRET_KEY no debe cambiar una vez configurados los negocios.
VERIFACTU_EMAIL=
VERIFACTU_BASE_URL=https://facturae.irenesolutions.com:8050/Kivu
VERIFACTU_TIMEOUT=30
# La sesión caduca: margen de renovación y duración asumida si la API no la indica.
VERIFACTU_SESSION_MARGIN=300
VERIFACTU_SESSION_LIFETIME=3600
# Datos del emisor. Si no hay ningún emisor dado de alta, se crea con estos valores.
VERIFACTU_EMISOR_NAME=
VERIFACTU_EMISOR_NIF=
VERIFACTU_SERIES_PREFIX=FAC

# Solo para pruebas locales: usa una API simulada en lugar de la real (no requiere
# credenciales). Se ignora en producción porque depende de DJANGO_DEBUG=True.
VERIFACTU_FAKE_API=
