# Copia este archivo como .env y completa los valores localmente.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# En local déjalo sin definir (equivale a True). En producción: False.
DJANGO_DEBUG=False

# Lista separada por comas. En Render no hace falta: se añade RENDER_EXTERNAL_HOSTNAME solo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF, con esquema (https://...). Opcional en Render.
DJANGO_CSRF_TRUSTED_ORIGINS=

# En local se usa SQLite aunque DATABASE_URL esté definido.
# Para conectarte intencionadamente a una base remota desde local, define DJANGO_USE_DATABASE_URL=True.
# Render activa automáticamente DATABASE_URL. Usa su URL pooled para la aplicación.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
