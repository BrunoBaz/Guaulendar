# Copia este archivo como .env y completa los valores localmente.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# En local déjalo sin definir (equivale a True). En producción: False.
DJANGO_DEBUG=False

# Lista separada por comas. En Render no hace falta: se añade RENDER_EXTERNAL_HOSTNAME solo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF, con esquema (https://...). Opcional en Render.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Pega aquí la URL de conexión pooled de Neon; no la compartas ni la subas a Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
